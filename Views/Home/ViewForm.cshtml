@{
    ViewData["Title"] = "View Form";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .form-preview-box {
        border: 2px solid #000;
        padding: 20px;
        border-radius: 10px;
        background: #f9f9f9;
    }
</style>

<div class="container mt-4">

    <h3>@ViewBag.FormName</h3>

    <form id="dynamicForm">

        <!-- 🔥 IMPORTANT WRAPPER -->
        <div class="form-preview-box">
            @Html.Raw(ViewBag.FormHtml)
        </div>

        <div class="text-end mt-3" id="submitWrapper">
            <button type="button" id="submitData" class="btn btn-success">
                Submit Form
            </button>
        </div>

    </form>

</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        let currentStageIndex = @ViewBag.CurrentStageIndex;

        const formName = $("<textarea>").html("@ViewBag.FormName").text().replace(/\n/g, "").trim();
        const version = parseInt("@ViewBag.Version") || 0;

        const isAllCompleted = '@ViewBag.IsAllCompleted' === 'True';

        let stagesRaw = @Html.Raw(Json.Serialize(ViewBag.FormJson ?? "[]"));

        let stages = typeof stagesRaw === "string"
        ? JSON.parse(stagesRaw)
        : stagesRaw;

        // ✅ If wrapped
        if (!Array.isArray(stages) && stages.stages) {
        stages = stages.stages;
        }


        $(document).ready(function () {

        $(".stage-block").hide();

        // 🔥 FUNCTION TO LOAD TABLE DATA
        function loadTableData(stageBlock, stageValues) {

        stageBlock.find("table").each(function () {

        let table = $(this);
        let tableId = table.attr("id");

        let rows = stageValues[tableId];
        if (!rows || rows.length === 0) return;

        table.find("tbody").empty();

        rows.forEach(row => {

        let tr = `<tr>`;

        Object.keys(row).forEach(key => {

        let value = row[key];

        tr += `<td>
        <input type="text" class="form-control" value="${value}" disabled />
        </td>`;
        });

        tr += `<td></td></tr>`;

        table.find("tbody").append(tr);
        });
        });
        }

        // 🔥 IF ALL COMPLETED
        if (isAllCompleted) {

        stages.forEach((stage, index) => {

        let stageBlock = $(`.stage-block[data-stage="${index}"]`);
        stageBlock.show();

        if (stage.values) {

        Object.keys(stage.values).forEach(key => {

        let field = stageBlock.find(`[name="${key}"]`);

        if (field.length === 0) return;

        if (field.attr("type") === "radio") {
        stageBlock.find(`[name="${key}"][value="${stage.values[key]}"]`)
        .prop("checked", true);
        } else {
        field.val(stage.values[key]);
        }
        });

        // 🔥 LOAD TABLE DATA
        loadTableData(stageBlock, stage.values);
        }

        // 🔒 Disable all inputs
        stageBlock.find("input, select, textarea").prop("disabled", true);

        // 🔥 HIDE ADD ROW BUTTON
        stageBlock.find("button:contains('+ Add Row')").hide();

        // 🔥 HIDE ACTION COLUMN (header + cells)
        stageBlock.find("table").each(function () {

        // Hide last column header (Action)
        $(this).find("thead th:last-child").hide();

        // Hide last column cells
        $(this).find("tbody td:last-child").hide();
        });

        });

        $("#submitWrapper").hide();

        return;
        }

        // 🔥 NORMAL FLOW
        stages.forEach((stage, index) => {

        let stageBlock = $(`.stage-block[data-stage="${index}"]`);

        if (index < currentStageIndex) {

        stageBlock.show();

        if (stage.values) {

        Object.keys(stage.values).forEach(key => {

        let field = stageBlock.find(`[name="${key}"]`);

        if (field.length === 0) return;

        if (field.attr("type") === "radio") {
        stageBlock.find(`[name="${key}"][value="${stage.values[key]}"]`)
        .prop("checked", true);
        } else {
        field.val(stage.values[key]);
        }
        });

        // 🔥 LOAD TABLE DATA
        loadTableData(stageBlock, stage.values);
        }

        stageBlock.find("input, select, textarea").prop("disabled", true);
        }

        else if (index === currentStageIndex) {
        stageBlock.show();
        }

        else {
        stageBlock.hide();
        }
        });

        });


        /* ---------------- SUBMIT ---------------- */

$("#submitData").click(function () {

    let btn = $(this);
    let isValid = true;

    let stageBlock = $(`.stage-block[data-stage="${currentStageIndex}"]`);

    /* ---------------- VALIDATION ---------------- */

    stageBlock.find("input[required], select[required]").each(function () {

        if (!$(this).val()) {
            $(this).css("border", "1px solid red");
            isValid = false;
        } else {
            $(this).css("border", "");
        }
    });

    if (!isValid) {
        alert("Please fill required fields");
        return;
    }

    let stageData = {};

    /* ---------------- NORMAL FIELDS ---------------- */

    stageBlock.find("input, select, textarea").each(function () {

        let name = $(this).attr("name");
        if (!name) return;

        // skip table fields
        if (name.includes("[]")) return;

        let type = $(this).attr("type");

        if (type === "radio") {
            if ($(this).is(":checked")) {
                stageData[name] = $(this).val();
            }
        } else {
            stageData[name] = $(this).val();
        }
    });

    /* ---------------- TABLE DATA ---------------- */

    stageBlock.find("table").each(function () {

        let table = $(this);
        let tableId = table.attr("id");

        let rows = [];

        table.find("tbody tr").each(function (rowIndex) {

            let rowData = {};
            let hasValue = false;

            $(this).find("input, select, textarea").each(function () {

                let name = $(this).attr("name");
                if (!name) return;

                let cleanName = name.replace("[]", "");

                let type = $(this).attr("type");
                let value = "";

                // 🔥 FIX: RADIO handling per row
                if (type === "radio") {

                    if ($(this).is(":checked")) {
                        value = $(this).val();
                    } else {
                        return;
                    }
                } else {
                    value = $(this).val();
                }

                if (value) hasValue = true;

                rowData[cleanName] = value;
            });

            // 🔥 FIX: Skip empty rows
            if (hasValue) {
                rows.push(rowData);
            }
        });

        // only save if rows exist
        if (rows.length > 0) {
            stageData[tableId] = rows;
        }
    });

    /* ---------------- SUBMIT ---------------- */

    btn.prop("disabled", true).text("Saving...");

    $.ajax({
        url: '/Home/UpdateStageCompletion',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            FormName: formName,
            StageIndex: currentStageIndex,
            Version: version,
            StageValues: stageData
        }),
        success: function () {
            alert("Stage Saved Successfully!");
            window.location.href = '/Home/ListForms';
        },
        error: function (err) {
            console.error(err);
            alert("Error saving stage");
            btn.prop("disabled", false).text("Submit");
        }
    });

});



        function addTableRow(tableId, fieldName, columns) {

        // ✅ Convert string → array
        if (typeof columns === "string") {
        columns = JSON.parse(decodeURIComponent(columns));
        }

        if (!Array.isArray(columns)) {
        console.error("Invalid columns:", columns);
        return;
        }

        let table = document.getElementById(tableId).querySelector('tbody');

        let rowHtml = `<tr>`;

        columns.forEach(col => {
        rowHtml += `
        <td>
        <input type="text"
        name="${fieldName}_${col.name}"
        class="form-control" />
        </td>`;
        });

        rowHtml += `
        <td>
        <button type="button"
        class="btn btn-danger btn-sm"
        onclick="this.closest('tr').remove()">
        X
        </button>
        </td>
        </tr>`;

        table.insertAdjacentHTML('beforeend', rowHtml);
        }

        function removeTableRow(btn) {
        let rows = $(btn).closest("tbody").find("tr").length;

        if (rows > 1) {
        $(btn).closest("tr").remove();
        } else {
        alert("At least one row required");
        }
        }


    </script>

}