@{
    ViewData["Title"] = "Dynamic Master Creation";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Dynamic Master Creation</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

    <link href="~/css/dynamic-master.css" rel="stylesheet" />
    <link href="~/css/form-builder.css" rel="stylesheet" />
</head>

<body>

    <div class="layout">

        <!-- LEFT : SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h6>Headings</h6>
                <button class="btn btn-sm btn-primary" onclick="openEditor()">Add / Edit</button>
            </div>
            <div id="sidebarTree"></div>
        </div>

        <!-- CENTER : FORM BUILDER -->
        @await Html.PartialAsync("_FormBuilder")

        <!-- RIGHT : CUSTOM CREATION -->
        <div class="controls">
            <h6 class="mb-3">Custom Creation</h6>
        </div>

    </div>

    <!-- MASTER EDITOR -->
    <div class="overlay" id="overlay">
        <div class="master-wrapper">
            <div class="master-header d-flex justify-content-between align-items-center">
                <h5>Dynamic Master Creation</h5>
                <div class="d-flex gap-2">
                    <input id="headingInput" class="form-control" placeholder="Enter Heading Name" />
                    <button class="btn btn-success" onclick="addHeading()">Add</button>
                </div>
            </div>

            <div class="tree-container">
                <div id="headingContainer"></div>
            </div>

            <div class="master-footer">
                <button class="btn btn-secondary" onclick="closeEditor()">Close</button>
                <button class="btn btn-primary" onclick="saveAll()">Save</button>
            </div>
        </div>
    </div>

    <!-- OPTION BUILDER -->
    <div class="overlay" id="optionOverlay">
        <div class="table-builder">
            <h5 id="optionTitle"></h5>

            <input id="optionLabel" class="form-control mb-2" placeholder="Field Label">
            <div id="optionList"></div>

            <button class="btn btn-sm btn-secondary mb-2" onclick="addOptionInput()">➕ Add Option</button>

            <div class="text-end">
                <button class="btn btn-secondary" onclick="closeOptionBuilder()">Cancel</button>
                <button class="btn btn-primary" onclick="createOptionField()">Create</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dynamic-master.js"></script>
    <script src="~/js/form-builder.js"></script>

</body>
</html>
