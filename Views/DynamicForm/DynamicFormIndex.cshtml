@{
    ViewData["Title"] = "Dynamic Form Builder";
}



<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .form-builder-box {
        border: 2px solid #000;
        padding: 20px;
        border-radius: 8px;
        background: #fafafa;
    }

    .field-card {
        padding: 12px;
        border-radius: 8px;
        background: white;
        border: 1px solid #ddd;
        position: relative;
    }

    .action-buttons {
        position: absolute;
        top: 5px;
        right: 5px;
        display: none;
    }

    .field-card:hover .action-buttons {
        display: block;
    }

    .form-placeholder {
        border: 2px dashed #ccc;
        padding: 30px;
        border-radius: 6px;
        text-align: center;
        color: #666;
        background: #fff;
        cursor: pointer;
    }

    /* Stage tabs improvements: wrap when many tabs or allow horizontal scroll */
    #stageTabs {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap; /* allow wrapping to new lines */
        max-width: 68vw; /* keep space for Create button on the right */
        overflow-x: auto; /* allow scrolling when needed */
        padding-bottom: 4px;
    }

    /* Make stage buttons slightly more compact */
    #stageTabs .btn {
        padding: .35rem .6rem;
        white-space: nowrap;
    }

    /* Ensure delete small button stays compact */
    #stageTabs .btn-sm {
        padding: .25rem .45rem;
    }
</style>

<div class="container mt-3">



    <div class="d-flex align-items-start mb-3">
        <div class="me-3">
            <h3 id="formTitle" class="mb-1">
                Dynamic Form Builder
                <button onclick="editTitle()">✏️</button>
            </h3>
            <!-- optional small icon line if needed -->
        </div>

        <!-- center: stage tabs -->
        <div class="flex-grow-1 d-flex justify-content-center">
            <div id="stageTabs" class="d-flex gap-2"></div>
        </div>

        <!-- right: action buttons stacked -->
        <div class="d-flex flex-column align-items-end ms-3 gap-2">
            <button class="btn btn-secondary" onclick="addStage()">+ Add Stage</button>
            <!-- ONLY JS TRIGGER (Removed data-bs-toggle to avoid duplicate backdrop) -->
            <button class="btn btn-primary" onclick="openModal()">Create</button>
        </div>
    </div>

    <!-- Stage Title (per-stage placeholder, clickable to edit) -->
    <div class="mb-2">
        <h4 id="stageTitle" class="mb-1" style="cursor:pointer;" onclick="editStageTitle()">Click to set stage title</h4>
    </div>

    <!-- FORM PREVIEW -->
    <div id="formPreview" class="form-builder-box"></div>

    <div class="text-end mt-3">
        <button id="submitForm" class="btn btn-success" style="display:none;">
            Submit Form
        </button>
    </div>

</div>

<!-- MODAL -->
<div class="modal fade" id="fieldModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Add Field</h5>
                <button class="btn-close" onclick="closeModal()"></button>
            </div>

            <div class="modal-body">

                <select id="fieldType" class="form-control mb-2">
                    <option value="">--Select--</option>
                    <option value="text">Textbox</option>
                    <option value="number">Number</option>
                    <option value="date">Date</option>
                    <option value="checkbox">Checkbox</option>
                    <option value="textarea">Textarea</option>
                    <option value="file">File Upload</option>
                    <option value="dropdown">Dropdown</option>
                    <option value="radio">Radio</option>
                    <option value="table">Table</option>
                    <option value="heading">Heading</option>
                    <option value="span">Span</option>
                </select>

                <input type="text" id="labelName" class="form-control mb-2" placeholder="Label Name" />

                <!-- Table Header Input -->
                <div id="tableHeaderDiv" style="display:none;">

                    <div id="tableColumnsContainer"></div>

                    <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addTableColumn()">
                        + Add Column
                    </button>

                </div>

                <!-- Heading Level -->
                <div id="headingLevelDiv" style="display:none;">
                    <select id="headingLevel" class="form-control mb-2">
                        <option value="h1">H1</option>
                        <option value="h2">H2</option>
                        <option value="h3">H3</option>
                        <option value="h4">H4</option>
                        <option value="h5">H5</option>
                        <option value="h6">H6</option>
                    </select>
                </div>

                <!-- File Accept -->
                <div id="fileOptionsDiv" style="display:none;">
                    <input type="text" id="fileAccept" class="form-control mb-2" placeholder=".pdf,.jpg,.png" />
                    <label>
                        <input type="checkbox" id="fileMultiple" /> Allow Multiple
                    </label>
                </div>

                <div id="optionsDiv" style="display:none;">
                    <select id="optionSource" class="form-control mb-2">
                        <option value="manual">Manual</option>
                        <option value="master">From Master</option>
                    </select>

                    <select id="optionDisplay" class="form-control mb-2">
                        <option value="single">Single</option>
                        <option value="row">Row</option>
                    </select>

                    <input type="text" id="optionsInput" class="form-control mb-2" placeholder="Yes,No" />

                    <select id="masterDropdown" class="form-control" style="display:none;"></select>
                </div>

                <div class="row mb-2">
                    <div class="col-md-4">
                        <label>Color</label>
                        <input type="color" id="labelColor" class="form-control" value="#000000" />
                    </div>
                    <div class="col-md-4">
                        <label>Required</label>
                        <select id="isRequired" class="form-control">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Line Break</label>
                        <select id="isBreak" class="form-control">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                </div>

                <button id="addField" class="btn btn-success w-100">
                    Add / Update Field
                </button>

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Inline edit for form title: replace with input, save on Enter or blur
        function editTitle() {
            try {
                const el = document.getElementById('formTitle');
                // avoid opening multiple editors
                if (el.querySelector('input')) return;

                // get current title text (exclude button)
                const clone = el.cloneNode(true);
                const btn = clone.querySelector('button');
                if (btn) btn.remove();
                const currentText = clone.textContent.trim();

                // build input and controls
                const input = document.createElement('input');
                input.type = 'text';
                input.value = currentText;
                input.className = 'form-control d-inline-block';
                input.style.maxWidth = '400px';
                input.style.display = 'inline-block';

                const saveBtn = document.createElement('button');
                saveBtn.className = 'btn btn-sm btn-primary ms-2';
                saveBtn.textContent = 'Save';

                const cancelBtn = document.createElement('button');
                cancelBtn.className = 'btn btn-sm btn-secondary ms-1';
                cancelBtn.textContent = 'Cancel';

                // keep original html to restore on cancel
                const originalHtml = el.innerHTML;

                // replace contents
                el.innerHTML = '';
                el.appendChild(input);
                el.appendChild(saveBtn);
                el.appendChild(cancelBtn);

                input.focus();

                function finishSave() {
                    const newTitle = input.value.trim() || 'Dynamic Form Builder';
                    el.innerHTML = `${newTitle} <button onclick="editTitle()">✏️</button>`;
                }

                saveBtn.addEventListener('click', finishSave);
                cancelBtn.addEventListener('click', function () {
                    el.innerHTML = originalHtml;
                });

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') finishSave();
                    if (e.key === 'Escape') el.innerHTML = originalHtml;
                });

                // save on blur (with small delay to allow click handlers)
                input.addEventListener('blur', function () {
                    setTimeout(function () {
                        if (document.activeElement !== saveBtn && document.activeElement !== cancelBtn) {
                            finishSave();
                        }
                    }, 150);
                });
            } catch (e) {
                console.error('editTitle error', e);
            }
        }
        let formStages = [];
        let currentStageIndex = -1;
        let editIndex = -1;
        let masterDataMap = {};
        let masterList = [];
        let modalInstance = null;

        /* ---------------- STAGE HANDLING ---------------- */

        function addStage() {
            // Ask user for a stage title (required and must be unique)
            Swal.fire({
                title: 'Stage Title',
                input: 'text',
                inputPlaceholder: 'Enter stage title',
                showCancelButton: true,
                confirmButtonText: 'Add',
                preConfirm: (value) => {
                    if (!value || !value.trim()) {
                        Swal.showValidationMessage('Title is required');
                        return false;
                    }

                    // ensure uniqueness
                    let exists = formStages.some(s => s.title && s.title.toLowerCase() === value.trim().toLowerCase());
                    if (exists) {
                        Swal.showValidationMessage('Title must be unique');
                        return false;
                    }

                    return value.trim();
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                let stageNumber = formStages.length + 1;
                formStages.push({
                    name: "Stage " + stageNumber,
                    title: result.value,
                    isCompleted: false,
                    fields: []
                });

                // ensure master data is available for new stage columns
                loadMasterData();

                currentStageIndex = formStages.length - 1;

                // clear any open modal/options for a fresh stage
                resetForm();

                updateStageTitleDisplay();
                renderStageTabs();
                renderFields();
                updateSubmitVisibility();
            });
        }

        function renderStageTabs() {

        $("#stageTabs").html("");

        formStages.forEach((s, i) => {

        let activeClass = i === currentStageIndex ? "btn-primary" : "btn-outline-primary";

        // show a small delete button for each stage only when more than one stage exists
        let deleteBtnHtml = '';
        if (formStages.length > 1) {
            // stopPropagation to avoid triggering the stage switch when clicking delete
            deleteBtnHtml = ` <button type="button" class="btn btn-sm btn-outline-danger ms-1" onclick="event.stopPropagation(); deleteStage(${i})">✖</button>`;
        }

        let displayTitle = s.title ? s.title : s.name + ' (Click to set title)';

        $("#stageTabs").append(`
            <div class="d-inline-flex align-items-center">
                <button class="btn ${activeClass}" onclick="switchStage(${i})">
                    ${displayTitle}
                </button>
                ${deleteBtnHtml}
            </div>
        `);
        });
        }

        function switchStage(index) {
        // clear modal inputs/options when switching stages
        resetForm();

        currentStageIndex = index;
        // update visible per-stage title
        updateStageTitleDisplay();
        renderStageTabs();
        renderFields();
        updateSubmitVisibility();
        }

        function editStageTitle() {
            if (currentStageIndex === -1) {
                Swal.fire({ icon: 'warning', text: 'Please add a stage first' });
                return;
            }

            let current = formStages[currentStageIndex].title || '';

            Swal.fire({
                title: 'Edit Stage Title',
                input: 'text',
                inputValue: current,
                showCancelButton: true,
                preConfirm: (value) => {
                    if (!value || !value.trim()) {
                        Swal.showValidationMessage('Title is required');
                        return false;
                    }

                    // uniqueness check (allow same if it's the same stage)
                    let exists = formStages.some((s, idx) => idx !== currentStageIndex && s.title && s.title.toLowerCase() === value.trim().toLowerCase());
                    if (exists) {
                        Swal.showValidationMessage('Title must be unique');
                        return false;
                    }
                    return value.trim();
                }
            }).then((result) => {
                if (!result.isConfirmed) return;
                formStages[currentStageIndex].title = result.value;
                updateStageTitleDisplay();
                renderStageTabs();
            });
        }

        function updateStageTitleDisplay() {
            let el = document.getElementById('stageTitle');
            if (!el) return;
            if (currentStageIndex === -1) {
                el.innerHTML = 'Click to set stage title';
                return;
            }
            let t = formStages[currentStageIndex].title || ('Stage ' + (currentStageIndex + 1) + ' (Click to set title)');
            el.innerHTML = t + ' <button onclick="editStageTitle()">✏️</button>';
        }

        function deleteStage(index) {
            try {
                Swal.fire({
                    title: 'Confirm',
                    text: 'Are you sure you want to delete this stage?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    formStages.splice(index, 1);

                    // clear any modal/options when a stage is removed
                    resetForm();

                    // renumber remaining stages (Stage 1..N)
                    formStages.forEach((s, idx) => s.name = 'Stage ' + (idx + 1));

                    // adjust current stage index:
                    if (formStages.length === 0) {
                        currentStageIndex = -1;
                    } else if (currentStageIndex === index) {
                        // if deleted the currently selected stage, move selection to same index or previous if at end
                        currentStageIndex = Math.min(index, formStages.length - 1);
                    } else if (currentStageIndex > index) {
                        // if selection was after deleted index, shift left
                        currentStageIndex -= 1;
                    }

                    updateStageTitleDisplay();
                    renderStageTabs();
                    renderFields();
                    updateSubmitVisibility();
                });
            } catch (e) {
                console.error('deleteStage error', e);
            }
        }

        /* ---------------- MODAL ---------------- */

        function openModal() {
        if (currentStageIndex === -1) {
        Swal.fire({ icon: 'warning', text: 'Please add a stage first' });
        return;
        }

        let modalEl = document.getElementById('fieldModal');
        modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        modalInstance.show();
        }

        function closeModal() {
        let modalEl = document.getElementById('fieldModal');
        let modal = bootstrap.Modal.getInstance(modalEl);

        if (modal) {
        modal.hide();
        }

        // ensure submit visibility is updated whenever fields are rendered
        updateSubmitVisibility();
        }

        function updateSubmitVisibility() {
            try {
                const btn = document.getElementById('submitForm');
                if (!btn) return;

                if (formStages.length === 0) {
                    btn.style.display = 'none';
                    return;
                }

                // only show when on the last stage
                if (currentStageIndex === formStages.length - 1) {
                    btn.style.display = 'inline-block';
                } else {
                    btn.style.display = 'none';
                }
            } catch (e) {
                console.error('updateSubmitVisibility error', e);
            }
        }

        function resetForm() {
        $("#fieldType").val('');
        $("#labelName").val('');
        $("#labelColor").val('#000000');

        $("#optionSource").val("manual");
        $("#optionsInput").val('').show();
        $("#optionDisplay").val('single');
        $("#masterDropdown").hide().val('');

        $("#isRequired").val("false");
        $("#isBreak").val("false");

        // Clear any table column settings from previous edits
        $("#tableColumnsContainer").empty();
        $("#tableHeaderDiv").hide();

        editIndex = -1;
        }

        /* ---------------- FIELD ADD ---------------- */

        $("#addField").click(function () {

        let type = $("#fieldType").val();

        // ✅ Build base field object
        let field = {
        type: type,
        label: $("#labelName").val(),
        color: $("#labelColor").val(),
        source: $("#optionSource").val(),
        display: $("#optionDisplay").val(),
        options: $("#optionsInput").val(),
        masterId: $("#masterDropdown").val(),
        required: $("#isRequired").val() === "true",
        isBreak: $("#isBreak").val() === "true",

        headingLevel: $("#headingLevel").val(),
        fileAccept: $("#fileAccept").val(),
        fileMultiple: $("#fileMultiple").is(":checked"),

        // 🔥 NEW (for table)
        tableColumns: []
        };

        /* ---------------- TABLE COLUMN BUILD ---------------- */

        if (type === "table") {

        let tableColumns = [];

        $("#tableColumnsContainer .table-col-row").each(function () {

        let name = $(this).find(".col-name").val();
        let colType = $(this).find(".col-type").val();
        let options = $(this).find(".col-options").val();

        let colSource = $(this).find('.col-option-source').val() || 'manual';
        let colMasterId = $(this).find('.col-master').val();

        if (!name) return; // skip empty

        let colDisplay = $(this).find('.col-option-display').val() || 'single';

        tableColumns.push({
        name: name,
        type: colType,
        stageIndex: parseInt($(this).find(".col-stage").val()), // 🔥 NEW
        source: colSource,
        masterId: colMasterId || null,
        display: colDisplay,
        options: (colSource === 'manual')
            ? (options ? options.split(',').map(x => x.trim()) : [])
            : (masterDataMap[colMasterId] || [])
        });
        });

        if (tableColumns.length === 0) {
        Swal.fire({ icon: 'warning', text: 'Add at least one table column' });
        return;
        }

        field.tableColumns = tableColumns;
        }

        /* ---------------- VALIDATION ---------------- */

        if ((type === "dropdown" || type === "radio" || type === "checkbox")) {

        if (field.source === "manual" && !field.options) {
        alert("Enter options");
        return;
        }

        if (field.source === "master" && !field.masterId) {
        alert("Select master");
        return;
        }
        }

        /* ---------------- SAVE ---------------- */

        let stage = formStages[currentStageIndex];

        if (editIndex === -1) {
        stage.fields.push(field);
        } else {
        stage.fields[editIndex] = field;
        editIndex = -1;
        }

        renderFields();
        resetForm();
        closeModal();
        });
        /* ---------------- RENDER ---------------- */

        function renderFields() {

        $("#formPreview").html("");

        if (currentStageIndex === -1) return;

        let fields = formStages[currentStageIndex].fields;

        let currentRow = [];

        fields.forEach((f, i) => {

        if (f.isBreak && currentRow.length > 0) {
        renderRow(currentRow);
        currentRow = [];
        }

        currentRow.push({ field: f, index: i });

        if (i === fields.length - 1) {
        renderRow(currentRow);
        }
        });

        // if no fields at this stage, show placeholder to prompt adding
        if (!fields || fields.length === 0) {
            let placeholder = `<div class="form-placeholder" onclick="openModal()">Click to add fields for this stage</div>`;
            $("#formPreview").append(placeholder);
        }
        }

function renderRow(rowFields) {

    let colSize = Math.floor(12 / rowFields.length);
    let rowHtml = `<div class="row">`;

    rowFields.forEach(item => {

        let f = item.field;
        let i = item.index;

        let fieldName = f.label.replace(/\W+/g, '');

        rowHtml += `
        <div class="col-md-${colSize} mb-3">
        <div class="field-card">

        <div class="action-buttons">
        <button onclick="editField(${i})">✏️</button>
        <button onclick="deleteField(${i})">✖</button>
        </div>
        `;

        // ✅ Skip label for heading & span
        if (f.type !== "heading" && f.type !== "span") {
            rowHtml += `
            <label style="color:${f.color}; font-weight:bold;">
            ${f.label}
            ${f.required ? '<span style="color:red;">*</span>' : ''}
            </label><br/>
            `;
        }

        // 🔹 TEXT / NUMBER / DATE
        if (f.type === "text" || f.type === "number" || f.type === "date") {
            rowHtml += `
            <input type="${f.type}"
                   name="${fieldName}"
                   class="form-control"
                   ${f.required ? 'required' : ''}/>
            `;
        }

        // 🔹 TEXTAREA
        if (f.type === "textarea") {
            rowHtml += `
            <textarea name="${fieldName}"
                      class="form-control"
                      ${f.required ? 'required' : ''}></textarea>
            `;
        }

        // 🔹 FILE
        if (f.type === "file") {
            rowHtml += `
            <input type="file"
                   name="${fieldName}"
                   class="form-control"
                   accept="${f.fileAccept || ''}"
                   ${f.fileMultiple ? 'multiple' : ''}
                   ${f.required ? 'required' : ''}/>
            `;
        }

        // 🔹 DROPDOWN
        if (f.type === "dropdown") {

            let values = f.source === "manual"
                ? f.options.split(',').map(x => x.trim())
                : (masterDataMap[f.masterId] || []);

            rowHtml += `<select name="${fieldName}" class="form-control" ${f.required ? 'required' : ''}>`;

            values.forEach(v => {
                rowHtml += `<option value="${v}">${v}</option>`;
            });

            rowHtml += `</select>`;
        }

        // 🔹 RADIO
        if (f.type === "radio") {

            let values = f.source === "manual"
                ? f.options.split(',').map(x => x.trim())
                : (masterDataMap[f.masterId] || []);

            values.forEach(v => {
                rowHtml += `
                <label class="me-2">
                <input type="radio" name="${fieldName}" value="${v}" ${f.required ? 'required' : ''}/> ${v}
                </label>`;
            });
        }

        // 🔹 CHECKBOX
        if (f.type === "checkbox") {

            let values = f.source === "manual"
                ? f.options.split(',').map(x => x.trim())
                : (masterDataMap[f.masterId] || []);

            let displayMode = f.display || 'single';

            values.forEach(v => {
                if (displayMode === 'row') {
                    rowHtml += `
                    <div>
                    <label>
                    <input type="checkbox" name="${fieldName}[]" value="${v}" ${f.required ? 'required' : ''}/> ${v}
                    </label>
                    </div>`;
                } else {
                    rowHtml += `
                    <label class="me-2">
                    <input type="checkbox" name="${fieldName}[]" value="${v}" ${f.required ? 'required' : ''}/> ${v}
                    </label>`;
                }
            });
        }

        // 🔥 TABLE (UPDATED PROPERLY)
        if (f.type === "table") {

        let columns = (f.tableColumns || []).filter(col => col.stageIndex <= currentStageIndex);
            let tableId = "table_" + fieldName;

            rowHtml += `
            <table class="table table-bordered" id="${tableId}">
                <thead>
                    <tr>`;

            columns.forEach(col => {
                rowHtml += `<th>${col.name}</th>`;
            });

            rowHtml += `<th style="width:80px;">Action</th></tr>
                </thead>
                <tbody></tbody>
            </table>

            <button type="button" class="btn btn-sm btn-success mt-2"
                onclick="addTableRow('${tableId}', '${fieldName}', ${JSON.stringify(columns).replace(/"/g, '&quot;')})">
                + Add Row
            </button>
            `;

            // ✅ AUTO ADD FIRST ROW (FIXED)
            setTimeout(() => {
                addTableRow(tableId, fieldName, columns);
            }, 0);
        }

        // 🔹 HEADING
        if (f.type === "heading") {
            let tag = f.headingLevel || "h3";
            rowHtml += `<${tag}>${f.label}</${tag}>`;
        }

        // 🔹 SPAN
        if (f.type === "span") {
            rowHtml += `<span>${f.label}</span>`;
        }

        rowHtml += `</div></div>`;
    });

    rowHtml += `</div>`;

    $("#formPreview").append(rowHtml);
}

        /* ---------------- EDIT / DELETE ---------------- */

        function editField(i) {

        let f = formStages[currentStageIndex].fields[i];

        $("#fieldType").val(f.type).trigger("change");
        $("#labelName").val(f.label);
        $("#labelColor").val(f.color);
        $("#optionSource").val(f.source).trigger("change");
        $("#optionDisplay").val(f.display || 'single');
        $("#optionsInput").val(f.options);
        $("#masterDropdown").val(f.masterId);
        $("#isRequired").val(f.required.toString());
        $("#isBreak").val(f.isBreak.toString());

        editIndex = i;
        // Populate table columns if editing a table
        if (f.type === 'table') {
            // ensure master data is loaded so column master selects are populated
            loadMasterData();
            $("#tableColumnsContainer").empty();
            (f.tableColumns || []).forEach(col => addTableColumn(col));
            $("#tableHeaderDiv").show();
        } else {
            $("#tableColumnsContainer").empty();
            $("#tableHeaderDiv").hide();
        }

        openModal();
        }

        function deleteField(i) {
        try {
            Swal.fire({
                title: 'Confirm',
                text: 'Are you sure you want to delete this field?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    formStages[currentStageIndex].fields.splice(i, 1);
                    renderFields();
                }
            });
        } catch (e) {
            console.error('deleteField error', e);
        }
        }

        /* ---------------- FINAL SUBMIT ---------------- */

        $("#submitForm").click(function () {

        if (formStages.length === 0) {
        alert("No stages added!");
        return;
        }

        // Validate every stage has a title
        for (let i = 0; i < formStages.length; i++) {
            if (!formStages[i].title || !formStages[i].title.trim()) {
                Swal.fire({ icon: 'warning', text: 'Please provide titles for all stages before saving.' });
                return;
            }
        }

        let formHtml = generateFullFormHTML();

        $.ajax({
        url: '/Home/SaveDynamicForm',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
        FormName: $("#formTitle").text().trim(),
        FormJson: JSON.stringify(formStages),
        FormHtml: formHtml   // ✅ FIX HERE
        }),
        success: function () {
        Swal.fire({ icon: 'success', text: 'Saved successfully!' });
        }
        });
        });

        $("#fieldType").change(function () {
        let type = $(this).val();

        $("#optionsDiv").toggle(type === "dropdown" || type === "radio" || type === "checkbox");
        $("#tableHeaderDiv").toggle(type === "table");
        $("#headingLevelDiv").toggle(type === "heading");
        $("#fileOptionsDiv").toggle(type === "file");
        });


        $("#optionSource").change(function () {

        if ($(this).val() === "manual") {
        $("#optionsInput").show();
        $("#masterDropdown").hide();
        } else {
        $("#optionsInput").hide();
        $("#masterDropdown").show();
        loadMasterData();
        }
        });

        function loadMasterData() {

        let data = [
        {
        id: 1,
        name: "Gender",
        values: ["Male", "Female", "Other"]
        },
        {
        id: 2,
        name: "Department",
        values: ["HR", "IT", "Finance", "Marketing", "Sales", "Admin"]
        },
        {
        id: 3,
        name: "Country",
        values: ["India", "USA", "UK", "Canada", "Australia", "Germany"]
        },
        {
        id: 4,
        name: "Skills",   // ✅ New checklist
        values: [
        "C#",
        "JavaScript",
        "HTML",
        "CSS",
        "SQL",
        "React",
        ".NET",
        "Angular",
        "Azure",
        "Git"
        ]
        }
        ];

        masterDataMap = {};
        masterList = data; // store master list for table column master select

        $("#masterDropdown").empty();
        $("#masterDropdown").append('<option value="">Select Master</option>');

        data.forEach(x => {
            masterDataMap[x.id] = x.values;
            $("#masterDropdown").append(`<option value="${x.id}">${x.name}</option>`);
        });
        }


        function generateFullFormHTML() {

        let fullHtml = "";

        formStages.forEach((stage, stageIndex) => {

        // ✅ Wrap each stage
        fullHtml += `<div class="stage-block" data-stage="${stageIndex}" style="display:${stageIndex === 0 ? 'block' : 'none'};">`;

        let currentRow = [];

        stage.fields.forEach((f, i) => {

        if (f.isBreak && currentRow.length > 0) {
        fullHtml += buildRowHTML(currentRow, stageIndex);
        currentRow = [];
        }

        currentRow.push({ field: f, index: i });

        if (i === stage.fields.length - 1) {
        fullHtml += buildRowHTML(currentRow, stageIndex);
        }
        });

        fullHtml += `</div>`; // ✅ close stage
        });

        return fullHtml;
        }


        function buildRowHTML(rowFields, stageIndex, isDisabled = false) {

        let count = rowFields.length;

        // ✅ Prevent layout breaking
        let colSize = Math.max(3, Math.floor(12 / count));

        let rowHtml = `<div class="row">`;

        rowFields.forEach(item => {

        let f = item.field;
        let fieldName = f.label.replace(/\W+/g, '');

        let requiredAttr = f.required ? 'required' : '';
        let disabledAttr = isDisabled ? 'disabled' : '';

        rowHtml += `
        <div class="col-md-${colSize}">
        <div class="mb-3">`;

        // ✅ LABEL
        if (f.type !== "heading" && f.type !== "span") {
        rowHtml += `
        <label style="color:${f.color}; font-weight:bold;">
        ${f.label}
        ${f.required ? '<span style="color:red;">*</span>' : ''}
        </label>`;
        }

        // 🔹 INPUT TYPES
        if (["text", "number", "date"].includes(f.type)) {
        rowHtml += `
        <input type="${f.type}"
        name="${fieldName}"
        class="form-control"
        ${requiredAttr}
        ${disabledAttr} />`;
        }

        // 🔹 TEXTAREA
        if (f.type === "textarea") {
        rowHtml += `
        <textarea name="${fieldName}"
        class="form-control"
        ${requiredAttr}
        ${disabledAttr}></textarea>`;
        }

        // 🔹 FILE
        if (f.type === "file") {
        rowHtml += `
        <input type="file"
        name="${fieldName}"
        class="form-control"
        accept="${f.fileAccept || ''}"
        ${f.fileMultiple ? 'multiple' : ''}
        ${requiredAttr}
        ${disabledAttr} />`;
        }

        // 🔹 DROPDOWN
        if (f.type === "dropdown") {

        let values = f.source === "manual"
        ? (f.options || "").split(',').map(x => x.trim())
        : (masterDataMap[f.masterId] || []);

        rowHtml += `
        <select name="${fieldName}" class="form-control" ${requiredAttr} ${disabledAttr}>
        <option value="">-- Select --</option>`;

        values.forEach(v => {
        rowHtml += `<option value="${v}">${v}</option>`;
        });

        rowHtml += `</select>`;
        }

        // 🔹 RADIO
        if (f.type === "radio") {

        let values = f.source === "manual"
        ? (f.options || "").split(',').map(x => x.trim())
        : (masterDataMap[f.masterId] || []);

        let displayMode = f.display || 'single';

        values.forEach((v, index) => {
        if (displayMode === 'row') {
            rowHtml += `
            <div>
            <label>
            <input type="radio"
            name="${fieldName}"
            value="${v}"
            ${f.required && index === 0 ? 'required' : ''}
            ${disabledAttr} />
            ${v}
            </label>
            </div>`;
        } else {
            rowHtml += `
            <label class="me-2">
            <input type="radio"
            name="${fieldName}"
            value="${v}"
            ${f.required && index === 0 ? 'required' : ''}
            ${disabledAttr} />
            ${v}
            </label>`;
        }
        });
        }

        // 🔹 CHECKBOX
        if (f.type === "checkbox") {

        let values = f.source === "manual"
        ? (f.options || "").split(',').map(x => x.trim())
        : (masterDataMap[f.masterId] || []);

        values.forEach((v) => {
        rowHtml += `
        <label class="me-2">
        <input type="checkbox"
        name="${fieldName}[]"
        value="${v}"
        ${disabledAttr} />
        ${v}
        </label>`;
        });
        }

        // 🔹 TABLE
        if (f.type === "table") {

        let columns = (f.tableColumns || [])
        .filter(col => col.stageIndex <= stageIndex);

        let tableId = "table_" + fieldName;

        // ✅ Encode safely
        let encodedColumns = encodeURIComponent(JSON.stringify(columns));

        rowHtml += `
        <table class="table table-bordered" id="${tableId}">
        <thead>
        <tr>`;

        columns.forEach(col => {
        rowHtml += `<th>${col.name}</th>`;
        });

        rowHtml += `
        <th style="width:80px;">Action</th>
        </tr>
        </thead>
        <tbody></tbody>
        </table>`;

        // ✅ IMPORTANT FIX HERE
        if (!isDisabled) {
        rowHtml += `
        <button type="button"
        class="btn btn-sm btn-success"
        onclick="addTableRow('${tableId}', '${fieldName}', '${encodedColumns}')">
        + Add Row
        </button>`;
        }
        }

        // 🔹 HEADING
        if (f.type === "heading") {
        let tag = f.headingLevel || "h3";
        rowHtml += `<${tag}>${f.label}</${tag}>`;
        }

        // 🔹 SPAN
        if (f.type === "span") {
        rowHtml += `<span>${f.label}</span>`;
        }

        rowHtml += `</div></div>`;
        });

        rowHtml += `</div>`;

        return rowHtml;
        }

        function addTableColumn(data = null) {
        // ensure master list is loaded so per-column master select is populated
        if (!masterList || masterList.length === 0) {
            loadMasterData();
        }

        // determine initial options input visibility and value
        let optionsStyle = 'display:none;';
        let optionsValue = '';
        let initialType = data?.type || 'text';
        let initialSource = data?.source || 'manual';
        let initialMaster = data?.masterId || '';
        if (data && data.source === 'manual' && (data.type === 'dropdown' || data.type === 'radio' || data.type === 'checkbox')) {
            optionsStyle = '';
            optionsValue = data.options ? data.options.join(',') : '';
        }

        // build master options HTML from masterList
        let masterOptionsHtml = '';
        masterList.forEach(m => {
            masterOptionsHtml += `<option value="${m.id}">${m.name}</option>`;
        });

        let html = `
        <div class="table-col-row border p-2 mb-2">

        <input type="text" class="form-control mb-1 col-name"
        placeholder="Column Name"
        value="${data?.name || ''}" />

        <select class="form-control mb-1 col-type">
        <option value="text">Text</option>
        <option value="number">Number</option>
        <option value="date">Date</option>
        <option value="textarea">Textarea</option>
        <option value="file">File Upload</option>
        <option value="dropdown">Dropdown</option>
        <option value="radio">Radio</option>
        <option value="checkbox">Checkbox</option>
        <option value="heading">Heading</option>
        <option value="span">Span</option>
        </select>

        <input type="text" class="form-control mb-1 col-options"
        placeholder="Options (Yes,No)"
        style="${optionsStyle}"
        value="${optionsValue}" />

        <select class="form-control mb-1 col-option-source">
            <option value="manual">Manual</option>
            <option value="master">From Master</option>
        </select>

        <select class="form-control mb-1 col-option-display">
            <option value="single">Single</option>
            <option value="row">Row</option>
        </select>

        <select class="form-control mb-1 col-master" style="display:none;">
            <option value="">Select Master</option>
        </select>

        <!-- Stage selection removed (use current stage). Keep hidden input to store stageIndex -->
        <input type="hidden" class="col-stage" value="${data?.stageIndex ?? currentStageIndex}" />

        <button type="button" class="btn btn-danger btn-sm"
        onclick="$(this).parent().remove()">Remove</button>

        </div>`;

        $("#tableColumnsContainer").append(html);

        let last = $("#tableColumnsContainer .table-col-row:last");
        // set the type, source and stage (stage might be from older saved data)
        last.find(".col-type").val(initialType);
        last.find(".col-option-source").val(initialSource);
        last.find('.col-option-display').val(data?.display || 'single');
        // ensure hidden stage index is set (preserve existing data or current stage)
        last.find(".col-stage").val(data?.stageIndex ?? currentStageIndex);
        // set options value and master selection explicitly, then trigger change handlers
        if (data) {
            last.find(".col-options").val(optionsValue);
            last.find(".col-master").val(initialMaster);
        }
        last.find('.col-type').trigger('change');
        last.find('.col-option-source').trigger('change');
        last.find('.col-option-display').trigger('change');

        // populate per-column master select from masterList (do after appended to DOM)
        let masterSelect = last.find('.col-master');
        masterSelect.empty();
        masterSelect.append('<option value="">Select Master</option>');
        masterList.forEach(m => {
            masterSelect.append(`<option value="${m.id}">${m.name}</option>`);
        });
        // re-set master value if provided
        if (initialMaster) masterSelect.val(initialMaster);
        }

        // Show options for dropdown/radio
        $(document).on("change", ".col-type", function () {

        let type = $(this).val();
        let optionsInput = $(this).closest(".table-col-row").find(".col-options");

        let optionSource = $(this).closest('.table-col-row').find('.col-option-source');
        let masterSelect = $(this).closest('.table-col-row').find('.col-master');

        if (type === "dropdown" || type === "radio" || type === 'checkbox') {
            // show source selector and then defer to its handler to show options/master
            optionSource.show();
            // trigger change so it applies current source visibility
            optionSource.trigger('change');
            // show display selector
            let optionDisplay = $(this).closest('.table-col-row').find('.col-option-display');
            optionDisplay.show();
            optionDisplay.trigger('change');
        } else {
            optionsInput.hide();
            optionSource.hide();
            masterSelect.hide();
            $(this).closest('.table-col-row').find('.col-option-display').hide();
        }
        });

        // Handle option source change (manual vs master) inside table column rows
        $(document).on('change', '.col-option-source', function () {
            let val = $(this).val();
            let row = $(this).closest('.table-col-row');
            if (val === 'manual') {
                row.find('.col-options').show();
                row.find('.col-master').hide();
            } else {
                row.find('.col-options').hide();
                let masterSelect = row.find('.col-master');
                // ensure masterList is populated
                if (!masterList || masterList.length === 0) loadMasterData();
                masterSelect.empty();
                masterSelect.append('<option value="">Select Master</option>');
                masterList.forEach(m => {
                    masterSelect.append(`<option value="${m.id}">${m.name}</option>`);
                });
                masterSelect.show();
            }
        });

        // Handle option display change (single vs row)
        $(document).on('change', '.col-option-display', function () {
            let val = $(this).val();
            let row = $(this).closest('.table-col-row');
            // just store/display; rendering handled during buildRowHTML/addTableRow
            if (val === 'row') {
                row.find('.col-options').attr('data-display','row');
            } else {
                row.find('.col-options').attr('data-display','single');
            }
        });

        // Confirm before removing a table column entry in the editor
        $(document).on('click', '.remove-col-btn', function () {
            if (!confirm('Remove this column?')) return;
            $(this).closest('.table-col-row').remove();
        });

        function addTableRow(tableId, fieldName, columns) {

        // columns may be passed as an encoded JSON string (from buildRowHTML) or as an array
        if (typeof columns === 'string') {
            try {
                columns = JSON.parse(decodeURIComponent(columns));
            } catch (e) {
                // fallback: try to parse as already-encoded json
                try { columns = JSON.parse(columns); } catch (e) { columns = []; }
            }
        }

        let rowHtml = `<tr>`;

        (columns || []).forEach(col => {

        let inputName = `${fieldName}_${col.name}[]`;

        rowHtml += `<td>`;

        if (col.type === "text") {
        rowHtml += `<input type="text" class="form-control" name="${inputName}" />`;
        }

        if (col.type === "textarea") {
        rowHtml += `<textarea class="form-control" name="${inputName}"></textarea>`;
        }

        if (col.type === "dropdown") {
        rowHtml += `<select class="form-control" name="${inputName}">`;

        col.options.forEach(opt => {
        rowHtml += `<option value="${opt}">${opt}</option>`;
        });

        rowHtml += `</select>`;
        }

        if (col.type === "radio") {

        col.options.forEach(opt => {
        rowHtml += `
        <label class="me-2">
        <input type="radio" name="${inputName}" value="${opt}" /> ${opt}
        </label>`;
        });
        }

        if (col.type === "checkbox") {
        // check display mode: default single (inline), or row (stacked)
        let displayMode = col.display || 'single';

        col.options.forEach(opt => {
        if (displayMode === 'row') {
            rowHtml += `
            <div>
            <label>
            <input type="checkbox" name="${inputName}" value="${opt}" /> ${opt}
            </label>
            </div>`;
        } else {
            rowHtml += `
            <label class="me-2">
            <input type="checkbox" name="${inputName}" value="${opt}" /> ${opt}
            </label>`;
        }
        });
        }

        rowHtml += `</td>`;
        });

        // ✅ DELETE BUTTON with confirmation
        rowHtml += `
        <td>
        <button type="button" class="btn btn-danger btn-sm delete-table-row-btn">✖</button>
        </td>`;

        rowHtml += `</tr>`;

        $("#" + tableId + " tbody").append(rowHtml);
        }

    </script>

}